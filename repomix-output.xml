/* =================================================================== */
.cyber-grid {
  position: fixed; inset: 0; z-index: -10;
  background-size: 60px 60px;
  background-image: 
    linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
  -webkit-mask-image: radial-gradient(circle at top center, black 30%, transparent 100%);
  pointer-events: none;
}

.orb { 
  position: fixed; border-radius: 50%; filter: blur(120px); z-index: -5; pointer-events: none; 
  will-change: transform;
  animation: float-orb 20s infinite alternate ease-in-out; 
}
.orb-1 { width: 50vw; height: 50vh; background: rgba(59, 130, 246, 0.15); top: -10vh; left: -10vw; }
.orb-2 { width: 40vw; height: 40vh; background: rgba(236, 72, 153, 0.1); bottom: -10vh; right: -10vw; animation-delay: -5s; }
.orb-3 { width: 30vw; height: 30vh; background: rgba(139, 92, 246, 0.1); top: 40vh; left: 40vw; animation-delay: -10s; }

@keyframes float-orb { 
  0% { transform: translate3d(0, 0, 0) scale(1); } 
  100% { transform: translate3d(5%, 10%, 0) scale(1.15); } 
}

@keyframes toast-slide { 
  0% { transform: translate3d(120%, 0, 0); opacity: 0; } 
  100% { transform: translate3d(0, 0, 0); opacity: 1; } 
}

.glass-card { 
  background: rgba(255, 255, 255, 0.02); 
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.05); 
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.4s ease, border-color 0.4s ease; 
  will-change: transform;
}
.glass-card:hover { 
  transform: translate3d(0, -8px, 0); 
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(99, 102, 241, 0.4); 
  box-shadow: 0 20px 40px -10px rgba(79, 70, 229, 0.2), inset 0 1px 0 rgba(255,255,255,0.1); 
}

/* NÚT BẤM GLOW MASTER NEON */
.btn-glow-master { position: relative; display: inline-flex; overflow: hidden; will-change: transform; }
.btn-glow-master::before { content: ''; position: absolute; inset: -2px; background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899, #3b82f6); background-size: 300%; border-radius: inherit; z-index: -1; animation: glow-spin 4s linear infinite; }
.btn-glow-master::after { content: ''; position: absolute; inset: 2px; background: #030712; border-radius: inherit; z-index: -1; transition: background 0.3s; }
.btn-glow-master:hover::after { background: rgba(0,0,0,0.5); }
@keyframes glow-spin { 0% { background-position: 0%; } 100% { background-position: 300%; } }

/* CHỮ QUÉM SÁNG (SHINE TEXT) */
.shine-text { background: linear-gradient(to right, #fff 20%, #8b5cf6 40%, #8b5cf6 60%, #fff 80%); background-size: 200% auto; color: transparent !important; -webkit-background-clip: text; background-clip: text; animation: shine 4s linear infinite; }
@keyframes shine { to { background-position: 200% center; } }

/* HỘP TERMINAL */
.terminal-window {
  background: rgba(10, 10, 15, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-top: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.8), 0 0 40px rgba(139, 92, 246, 0.3); backdrop-filter: blur(20px);
