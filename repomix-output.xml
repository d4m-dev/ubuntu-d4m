.cursor { display: inline-block; width: 8px; height: 18px; background-color: #3b82f6; animation: blink 1s step-end infinite; vertical-align: middle; margin-left: 4px; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

/* DẢI BĂNG CÔNG NGHỆ CHẠY VÔ TẬN */
.marquee-wrapper { overflow: hidden; white-space: nowrap; mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); padding: 20px 0; }
.marquee-content { display: inline-block; animation: scroll-left 30s linear infinite; will-change: transform; }
.marquee-item { display: inline-flex; align-items: center; gap: 8px; padding: 10px 24px; margin: 0 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 999px; font-weight: 600; transition: all 0.3s; }
.marquee-item:hover { background: rgba(255,255,255,0.1); border-color: rgba(139,92,246,0.5); box-shadow: 0 0 15px rgba(139,92,246,0.3); }
@keyframes scroll-left { 0% { transform: translate3d(0,0,0); } 100% { transform: translate3d(-50%,0,0); } }
/* =================================================================== */
/* 🎨 D4M DESIGN SYSTEM — THỐNG NHẤT TOÀN ỨNG DỤNG                     */
/* Áp dụng chung cho mọi trang (tools, social, docs, auth, hub)        */
/* =================================================================== */

/* ---- Biến theme thống nhất ---- */
:root {
  --d4m-bg: #030712;
  --d4m-bg-soft: #0b0f19;
  --d4m-surface: rgba(255,255,255,0.03);
  --d4m-surface-hover: rgba(255,255,255,0.07);
  --d4m-border: rgba(255,255,255,0.08);
  --d4m-border-accent: rgba(99,102,241,0.4);
  --d4m-text: #f8fafc;
  --d4m-text-dim: #94a3b8;
  --d4m-text-faint: #64748b;
  --d4m-primary: #3b82f6;
  --d4m-secondary: #8b5cf6;
  --d4m-accent: #ec4899;
  --d4m-radius: 1rem;
}

/* ---- PageShell: nền + container thống nhất ---- */
.d4m-page {
  min-height: 100vh;
  background-color: var(--d4m-bg);
  color: var(--d4m-text);
  position: relative;
  font-family: 'Inter', system-ui, sans-serif;
  overflow-x: hidden;
}
.d4m-page > .d4m-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
  position: relative;
  z-index: 10;
}

/* ---- Header tiêu đề trang thống nhất ---- */
.d4m-page-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}
.d4m-page-header .d4m-back {
  width: 42px; height: 42px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--d4m-surface);
  border: 1px solid var(--d4m-border);
  color: var(--d4m-text-dim);
  transition: all .25s;
  flex-shrink: 0;
  cursor: pointer;
}
.d4m-page-header .d4m-back:hover {
  background: var(--d4m-surface-hover);
  color: #fff;
  border-color: var(--d4m-border-accent);
}
.d4m-page-title {
  font-family: 'Outfit', 'Inter', sans-serif;
  font-weight: 800;
  font-size: clamp(1.6rem, 4vw, 2.25rem);
  letter-spacing: -0.02em;
  margin: 0;
  background: linear-gradient(to right, #fff, #a5b4fc);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.d4m-page-subtitle {
  color: var(--d4m-text-dim);
  font-size: .95rem;
  margin-top: .3rem;
}

/* ---- Card glass thống nhất ---- */
.d4m-card {
  background: var(--d4m-surface);
  border: 1px solid var(--d4m-border);
  border-radius: var(--d4m-radius);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  padding: 1.5rem;
  transition: transform .3s cubic-bezier(.16,1,.3,1), border-color .3s, background .3s;
}
.d4m-card:hover {
  border-color: var(--d4m-border-accent);
  background: var(--d4m-surface-hover);
}

/* ---- Button thống nhất ---- */
.d4m-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: .7rem 1.4rem;
  border-radius: .75rem;
  font-weight: 600;
  font-size: .9rem;
  border: 1px solid var(--d4m-border);
  background: var(--d4m-surface);
  color: var(--d4m-text);
  cursor: pointer;
  transition: all .25s;
  white-space: nowrap;
}
.d4m-btn:hover { background: var(--d4m-surface-hover); border-color: var(--d4m-border-accent); transform: translateY(-1px); }
.d4m-btn-primary {
  background: linear-gradient(135deg, var(--d4m-primary), var(--d4m-secondary));
  border: none;
  color: #fff;
  box-shadow: 0 4px 20px -4px rgba(99,102,241,.5);
}
.d4m-btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
.d4m-btn:disabled { opacity: .6; cursor: not-allowed; transform: none !important; }

/* ---- Input thống nhất ---- */
.d4m-input, .d4m-textarea, .d4m-select {
  width: 100%;
  padding: .7rem 1rem;
  border-radius: .75rem;
  background: rgba(0,0,0,.4);
  border: 1px solid var(--d4m-border);
  color: var(--d4m-text);
  font-size: .9rem;
  outline: none;
  transition: border-color .25s, box-shadow .25s;
}
.d4m-input:focus, .d4m-textarea:focus, .d4m-select:focus {
  border-color: var(--d4m-primary);
  box-shadow: 0 0 0 3px rgba(59,130,246,.2);
}
.d4m-input::placeholder, .d4m-textarea::placeholder { color: var(--d4m-text-faint); }

/* ---- Label thống nhất ---- */
.d4m-label {
  display: block;
  font-size: .8rem;
  font-weight: 600;
  color: var(--d4m-text-dim);
  margin-bottom: .4rem;
  text-transform: uppercase;
  letter-spacing: .03em;
}

/* ---- Badge / chip thống nhất ---- */
.d4m-badge {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .3rem .8rem;
  border-radius: 999px;
  font-size: .75rem;
  font-weight: 600;
  background: rgba(59,130,246,.12);
  border: 1px solid rgba(59,130,246,.3);
  color: #93c5fd;
}

/* ---- Section title ---- */
.d4m-section-title {
  font-family: 'Outfit', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  margin: 2rem 0 1rem;
  display: flex;
  align-items: center;
  gap: .6rem;
  color: var(--d4m-text);
}
.d4m-section-title::before {
  content: '';
  width: 4px; height: 1.1em;
  border-radius: 2px;
  background: linear-gradient(180deg, var(--d4m-primary), var(--d4m-secondary));
}

/* ---- Grid thống nhất ---- */
.d4m-grid {
  display: grid;
  gap: 1.25rem;
}
.d4m-grid-2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
.d4m-grid-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
.d4m-grid-4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); }

/* ---- Stat card ---- */
.d4m-stat {
  background: var(--d4m-surface);
  border: 1px solid var(--d4m-border);
  border-radius: var(--d4m-radius);
  padding: 1.25rem;
  transition: border-color .3s;
}
.d4m-stat:hover { border-color: var(--d4m-border-accent); }
.d4m-stat .value {
  font-family: 'Outfit', sans-serif;
  font-weight: 800;
  font-size: 1.75rem;
  background: linear-gradient(135deg, var(--d4m-primary), var(--d4m-secondary));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.d4m-stat .label { color: var(--d4m-text-dim); font-size: .8rem; margin-top: .2rem; }

/* ---- Table thống nhất ---- */
.d4m-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.d4m-table th {
  text-align: left;
  padding: .75rem 1rem;
  color: var(--d4m-text-dim);
  font-size: .75rem;
  text-transform: uppercase;
  letter-spacing: .05em;
  border-bottom: 1px solid var(--d4m-border);
}
.d4m-table td { padding: .75rem 1rem; border-bottom: 1px solid rgba(255,255,255,.04); }
.d4m-table tr:hover td { background: rgba(255,255,255,.02); }

/* ---- Empty / loading ---- */
.d4m-empty {
  text-align: center;
  padding: 4rem 1rem;
  color: var(--d4m-text-faint);
  font-size: .95rem;
}
.d4m-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .75rem;
  padding: 4rem;
  color: var(--d4m-text-dim);
}
.d4m-spinner {
  width: 2rem; height: 2rem;
  border: 3px solid rgba(255,255,255,.1);
  border-top-color: var(--d4m-primary);
  border-radius: 50%;
  animation: d4m-spin .8s linear infinite;
}
@keyframes d4m-spin { to { transform: rotate(360deg); } }

/* ---- Error banner ---- */
.d4m-error {
  background: rgba(239,68,68,.1);
  border: 1px solid rgba(239,68,68,.3);
  color: #fca5a5;
  padding: .75rem 1rem;
  border-radius: .75rem;
  font-size: .85rem;
  margin-bottom: 1rem;
}

/* ---- Form field spacing ---- */
.d4m-field { margin-bottom: 1.25rem; }

/* ===== 💰 DonateModal: pháo hoa + icon quay ===== */
@keyframes confetti-fly {
  0%   { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; }
  100% { transform: translate(var(--cf-x, 0px), var(--cf-y, -60px)) rotate(540deg) scale(.4); opacity: 0; }
}
.d4m-rot { animation: d4m-rotate 1s linear infinite; }
@keyframes d4m-rotate { to { transform: rotate(360deg); } }
</file>

<file path="frontend/nginx.conf">
# ============================================================
# 🎨 D4M FRONTEND — Nginx config
# Phục vụ React SPA + proxy /api và /static tới backend
# ============================================================
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # API → backend (FastAPI port 16868 trong docker network)
    location /api/ {
        proxy_pass http://backend:16868;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # 🖼️💎 SOCIAL HUB ASSETS — khung viền (429) + Linh thú/Linh bảo (165) + manifests
    # (^~ thắng mọi regex bên dưới → proxy thẳng về backend, không rơi vào root SPA)
    location ^~ /avatar_frames/ {
        proxy_pass http://backend:16868;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location ^~ /linhbao/ {
        proxy_pass http://backend:16868;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location = /avatar_frames.json {
        proxy_pass http://backend:16868;
        proxy_set_header Host $host;
    }
    location = /spirit_items.json {
        proxy_pass http://backend:16868;
        proxy_set_header Host $host;
    }

    # SPA routing — mọi đường dẫn fallback về index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache tĩnh
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
</file>

