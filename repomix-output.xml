@import "tailwindcss";

@layer base {
  :root { 
    --bg-dark: #030712; 
    --primary: #3b82f6; 
    --secondary: #8b5cf6; 
  }
  
  body { 
    background-color: var(--bg-dark); 
    color: #f8fafc; 
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
    overflow-x: hidden; 
  }
  
  h1, h2, h3, h4, .font-heading { 
    font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; 
  }
  
