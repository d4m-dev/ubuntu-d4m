<file path="frontend/src/components/music/music.css">
:root {
  --bg: #0a0a0a;
  --bg-elev: #121212;
  --bg-elev2: #181818;
  --bg-hover: #232323;
  --border: rgba(255, 255, 255, 0.08);
  --text: #ffffff;
  --text-dim: #b3b3b3;
  --text-faint: #8f8f8f;
  --accent: #1ed760;
  --accent-dark: #148f42;
  --danger: #f15e6c;
  --sidebar-w: 250px;
  --player-h: 92px;
}

* { box-sizing: border-box; }
html, body, #root { height: 100%; margin: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #3a3a3a; border-radius: 6px; }
::-webkit-scrollbar-track { background: transparent; }

.app-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, #1a1a1a 0%, #0a0a0a 40%);
}
.main-row { flex: 1; display: flex; min-height: 0; }

/* ===== Sidebar ===== */
.sidebar {
  width: var(--sidebar-w);
  flex-shrink: 0;
  background: #000;
  display: flex;
  flex-direction: column;
  padding: 18px 12px;
  gap: 4px;
  overflow-y: auto;
}
.brand { display: flex; align-items: center; gap: 10px; padding: 6px 10px 16px; }
.brand .logo {
  width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
  background: linear-gradient(135deg, #1ed760, #0a4d2b);
  display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.brand b { font-size: 17px; letter-spacing: -0.3px; }
.brand small { display: block; color: var(--accent); font-size: 10px; letter-spacing: 0.6px; }

.nav-link {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 12px; border-radius: 8px; color: var(--text-dim);
  font-size: 14px; font-weight: 600; transition: 0.15s; border: none; background: none; width: 100%; text-align: left;
}
.nav-link:hover { color: var(--text); }
.nav-link.active { color: var(--text); background: var(--bg-elev2); }
.nav-link svg { width: 20px; height: 20px; flex-shrink: 0; }

.sidebar .section-title { padding: 14px 12px 6px; font-size: 11px; color: var(--text-faint); letter-spacing: 1px; font-weight: 700; }

/* ===== Main content ===== */
.content { flex: 1; overflow-y: auto; padding: 24px 28px 140px; }
.content-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.page-title { font-size: 26px; font-weight: 800; letter-spacing: -0.5px; margin: 0; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 28px 0 16px; }
.section-title-lg { font-size: 20px; font-weight: 800; margin: 0; }
.link-more { color: var(--text-dim); font-size: 13px; font-weight: 600; }
.link-more:hover { color: var(--text); text-decoration: underline; }

/* cards grid */
.card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; }
.playlist-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }

.song-card {
  background: var(--bg-elev2); border-radius: 12px; padding: 14px; cursor: pointer;
  transition: 0.18s; position: relative;
}
.song-card:hover { background: var(--bg-hover); }
.song-card .art { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; margin-bottom: 12px; background: #222; }
.song-card .art img { width: 100%; height: 100%; object-fit: cover; display: block; }
.song-card .play-fab {
  position: absolute; right: 10px; bottom: 10px; width: 44px; height: 44px; border-radius: 50%;
  background: var(--accent); color: #000; border: none; display: flex; align-items: center; justify-content: center;
  opacity: 0; transform: translateY(8px); transition: 0.2s; box-shadow: 0 6px 16px rgba(0,0,0,.5);
}
.song-card:hover .play-fab { opacity: 1; transform: translateY(0); }
.song-card .play-fab svg { width: 20px; height: 20px; }
.song-card .title { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.song-card .artist { color: var(--text-dim); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }

.playlist-card { background: var(--bg-elev2); border-radius: 12px; overflow: hidden; cursor: pointer; transition: 0.18s; }
.playlist-card:hover { background: var(--bg-hover); }
.playlist-card .art { aspect-ratio: 1; overflow: hidden; background: #222; }
.playlist-card .art img { width: 100%; height: 100%; object-fit: cover; }
.playlist-card .meta { padding: 12px 14px; }
.playlist-card .name { font-weight: 700; font-size: 15px; }
.playlist-card .desc { color: var(--text-dim); font-size: 12.5px; margin-top: 3px; }

/* ===== Top bar ===== */
.topbar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 12px; padding: 14px 4px; backdrop-filter: blur(8px); }
.search-box { position: relative; flex: 1; max-width: 460px; }
.search-box svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: var(--text-dim); }
.search-box input {
  width: 100%; padding: 10px 14px 10px 40px; border-radius: 30px; border: none;
  background: #242424; color: var(--text); font-size: 14px; outline: none;
}
.search-box input:focus { background: #2c2c2c; outline: 1px solid var(--border); }
.search-box input::placeholder { color: var(--text-faint); }
.user-chip { display: flex; align-items: center; gap: 10px; background: var(--bg-elev2); border: 1px solid var(--border); padding: 6px 8px 6px 6px; border-radius: 30px; }
.user-chip img { width: 28px; height: 28px; border-radius: 50%; background: var(--accent-dark); }
.user-chip span { font-size: 13px; font-weight: 600; }

/* ===== Table / rows ===== */
.song-list { display: flex; flex-direction: column; }
.song-row {
  display: grid; grid-template-columns: 28px 46px 1fr 0.7fr 60px 90px; gap: 14px; align-items: center;
  padding: 8px 12px; border-radius: 8px; transition: 0.12s; cursor: pointer;
}
.song-row:hover { background: var(--bg-hover); }
.song-row .idx { color: var(--text-faint); font-size: 14px; text-align: center; }
.song-row .thumb { width: 46px; height: 46px; border-radius: 6px; object-fit: cover; background: #222; }
.song-row .tt { min-width: 0; }
.song-row .tt .t { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.song-row .tt .a { color: var(--text-dim); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.song-row .album { color: var(--text-dim); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.song-row .dur { color: var(--text-faint); font-size: 13px; }
.song-row .plays { color: var(--text-faint); font-size: 13px; text-align: right; }
.icon-btn { background: none; border: none; color: var(--text-dim); padding: 6px; border-radius: 50%; display: inline-flex; }
.icon-btn:hover { color: var(--text); }
.icon-btn svg { width: 18px; height: 18px; }
.icon-btn.liked { color: var(--accent); }

/* ===== Player ===== */
.player {
  height: var(--player-h); background: #000; border-top: 1px solid var(--border);
  display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center; gap: 16px; padding: 0 18px; flex-shrink: 0;
}
.player .now { display: flex; align-items: center; gap: 12px; min-width: 0; }
.player .now img { width: 52px; height: 52px; border-radius: 6px; object-fit: cover; background: #222; }
.player .now .tt { min-width: 0; }
.player .now .t { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player .now .a { font-size: 12px; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player .controls { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.player .btns { display: flex; align-items: center; gap: 20px; }
.player .btns .play { width: 40px; height: 40px; border-radius: 50%; background: var(--text); color: #000; border: none; display: flex; align-items: center; justify-content: center; }
.player .btns .play:hover { transform: scale(1.05); }
.player .btns .play svg { width: 20px; height: 20px; }
.player .btns .small { color: var(--text-dim); background: none; border: none; display: flex; padding: 4px; }
.player .btns .small svg { width: 18px; height: 18px; }
.player .btns .small:hover { color: var(--text); }
.player .seekbar { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 560px; }
.player .seekbar span { font-size: 11px; color: var(--text-faint); min-width: 34px; text-align: center; }
.player .vol { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
.player .vol svg { width: 18px; height: 18px; color: var(--text-dim); }

.progress { flex: 1; height: 4px; background: #3a3a3a; border-radius: 2px; cursor: pointer; position: relative; }
.progress .fill { height: 100%; background: var(--text); border-radius: 2px; position: relative; }
.progress:hover .fill { background: var(--accent); }
.progress .knob { position: absolute; right: -6px; top: 50%; transform: translateY(-50%); width: 12px; height: 12px; border-radius: 50%; background: var(--text); opacity: 0; }
.progress:hover .knob { opacity: 1; }

/* ===== Misc ===== */
.empty { text-align: center; color: var(--text-faint); padding: 60px 20px; font-size: 15px; }
.spinner { width: 36px; height: 36px; border: 3px solid #333; border-top-color: var(--accent); border-radius: 50%; margin: 40px auto; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.badge-admin { background: var(--accent); color: #000; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 20px; letter-spacing: 0.5px; }
.muted { color: var(--text-dim); }
.hint { color: var(--text-faint); font-size: 12.5px; margin-top: 6px; }

/* ============================================================
   📱 RESPONSIVE — mobile / tablet
   ============================================================ */
@media (max-width: 1023px) {
  /* Ẩn sidebar desktop — đã có MobileNav */
  .sidebar { display: none; }
  .content { padding: 10px 12px 170px; }

  /* Player nổi ngay trên MobileNav (56px) */
  .player {
    position: fixed; left: 0; right: 0; bottom: 56px; z-index: 25;
    height: auto; padding: 8px 12px;
    grid-template-columns: 1fr auto; gap: 8px;
  }
  .player .vol { display: none; }
  .player .seekbar { display: none; }
  .player .controls { flex-direction: row; gap: 10px; }
  .player .now img { width: 40px; height: 40px; }
}

@media (max-width: 640px) {
  /* TopBar: ẩn tên user, giữ avatar */
  .user-chip span { display: none; }
  .badge-admin { display: none; }
  .content-header { flex-wrap: wrap; gap: 8px; }
  .section-head { margin: 20px 0 12px; }
  .card-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .playlist-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
}
</file>

