        <p className="hint" style={{ textAlign: "center" }}>
          Chưa có tài khoản? <Link to="/music/register" style={{ color: "var(--accent)" }}>Đăng ký ngay</Link>
        </p>
      </form>
    </div>
  );
}

const inputStyle = {
  width: "100%", padding: "11px 14px", borderRadius: 8, border: "1px solid var(--border)",
