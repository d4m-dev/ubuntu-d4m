@router.get(U.USERS["DETAIL"])
def get_public_profile(username: str):
    """Hồ sơ công khai của user + các playlist công khai của họ."""
    # Cache 60s
    cache_key = f"profile:{username}"
    cached = cache_get(cache_key)
