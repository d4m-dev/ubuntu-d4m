+        else:
+            try:
+                with _db() as conn:
+                    with conn.cursor() as cur:
+                        cur.execute("SELECT id FROM users WHERE username=%s", (sub,))
+                        row = cur.fetchone()
+                        uid = row["id"] if row else None
+            except Exception:
+                uid = None
+    if not uid:
         raise HTTPException(status_code=401, detail="Token không hợp lệ.")
+    return int(uid)
 
 
