# ============================================================
# 🔗 FRONTEND → BACKEND (D4M) — BẢN MẪU
#   cp .env.example .env   rồi bỏ comment lựa chọn của bạn
# ============================================================

# ---------- LỰA CHỌN 1: gọi thẳng backend local ----------
# VITE_API_BASE_URL=http://127.0.0.1:16868
# VITE_WS_BASE_URL=ws://127.0.0.1:16868

# ---------- LỰA CHỌN 2: API production ----------
# VITE_API_BASE_URL=https://api.d4mdev.click
# VITE_WS_BASE_URL=wss://api.d4mdev.click

# ---------- LỰA CHỌN 3 (mặc định khi không có .env): qua proxy ----------
# Để CẢ HAI trống → same-origin; vite dev / nginx docker proxy về backend:16868
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
