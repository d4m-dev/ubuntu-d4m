# ============================================================
# 🎯 D4M ECOSYSTEM — BẢN MẪU CẤU HÌNH (.env.example)
# ============================================================
# Sao chép thành .env và điền giá trị của bạn:
#   cp .env.example .env
#
# KHÔNG BAO GIỜ commit file .env (chứa secret) lên git!
# ============================================================

# ============================================================
# 🖥️ MÁY CHỦ
# ============================================================
HOST=0.0.0.0
PORT=16868
DB_ADMIN_PORT=8888
ENVIRONMENT=development          # development | production

# ============================================================
# 🔐 AUTH & JWT
# ============================================================
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên bí mật (production)!
SECRET_KEY=hay-doi-thanh-chuoi-jwt-bi-mat-ngau-nhien
ADMIN_KEY=admin16868
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin

# ============================================================
# 🗄️ DATABASE (MariaDB / MySQL)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=d4m
DB_PASS=doi-mat-khau-db
DB_NAME=social_hub

# ============================================================
# 🎵 AUDIO WORKSPACE
# ============================================================
# Thư mục chứa file nhạc (cấu trúc: MUSIC_DIR/<folder_name>/<files>)
MUSIC_FILES_DIR=./audio_workspace/music/

# ============================================================
# ⚡ REDIS — Rate Limiting & JWT Blacklist (chống DDoS)
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ============================================================
# 💰 DONATE / SEPAY / VIETQR
# ============================================================
# Token bảo mật dùng để xác thực Webhook từ SePay (đặt bất kỳ chuỗi bí mật)
SEPAy_TOKEN=doi-thanh-token-sepay-bi-mat

# Thông tin ngân hàng cho mã QR (VietQR)
# BANK_ID: mã ngân hàng (MB, VCB, TCB, ACB, VPB...)
BANK_ID=MB
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=LY THUA AN

# ============================================================
# 🤖 GEMINI AI (J.A.R.V.I.S Chat, AutoCode)
# ============================================================
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================================
# 🤖 TELEGRAM BOT (báo cáo hệ thống, thời tiết)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8267913616

# ============================================================
# 📡 CLOUDFLARE TUNNEL (Zero Trust)
# ============================================================
# Lấy token tại Cloudflare Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================================
# 📅 GOOGLE CALENDAR & SERVICE ACCOUNT
# ============================================================
# Đặt file credentials vào thư mục backend/auth/
#   - d4m-calendar-key.json  : Service account cho Google Calendar
#   - credentials.json       : OAuth credentials (Google Drive)
GCAL_EMAIL=your-calendar@service-account.iam.gserviceaccount.com

# ============================================================
# 📧 EMAIL (SSO verify, forgot password)
# ============================================================
SENDER_EMAIL=youremail@gmail.com
SENDER_PASSWORD=app-password-google

# ============================================================
# 🌐 FRONTEND (Vite env — nằm ở frontend/.env, KHÔNG nằm ở đây)
# ============================================================
# VITE_API_BASE_URL=
# VITE_WS_BASE_URL=
